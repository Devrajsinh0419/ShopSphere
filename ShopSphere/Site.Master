<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="ShopSphere.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - ShopSphere</title>

    <!-- Favicon -->
    <link runat="server" rel="icon" type="image/x-icon" href="~/favicon.ico" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&display=swap" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <!-- Tailstore Template Stylesheets -->
    <link runat="server" rel="stylesheet" href="~/assets/css/styles.css" />
    <link runat="server" rel="stylesheet" href="~/assets/css/custom.css" />

    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body class="bg-gray-50 text-gray-900 font-sans min-h-screen flex flex-col justify-between">
    <form runat="server">
        <asp:ScriptManager runat="server">
            <Scripts>
                <%-- ASP.NET Framework Scripts --%>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
            </Scripts>
        </asp:ScriptManager>

        <!-- Header / Navigation Bar -->
        <header class="bg-gray-dark sticky top-0 z-50 shadow-lg border-b border-gray-800">
            <div class="container mx-auto flex justify-between items-center py-4 px-4 sm:px-6 lg:px-8 site-header-layout">
                <!-- Left Section: Logo with proper right margin -->
                <div class="flex items-center shrink-0 mr-6 xl:mr-10 site-header-brand">
                    <a runat="server" href="~/Default.aspx" class="flex items-center group">
                        <img runat="server" src="~/assets/images/template-white-logo.png" alt="ShopSphere" class="h-6 w-auto transition-transform group-hover:scale-105 site-header-logo" />
                    </a>
                </div>

                <!-- Hamburger Menu Button (Mobile) -->
                <div class="flex lg:hidden site-header-toggle">
                    <button type="button" id="hamburger" class="text-white focus:outline-none p-2 rounded-lg hover:bg-gray-800 transition" aria-label="Toggle navigation" aria-controls="mobile-menu" aria-expanded="false">
                        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
                        </svg>
                    </button>
                </div>

                <!-- Center Section: Main Navigation Links with Generous Spacing -->
                <nav class="hidden lg:flex items-center justify-center flex-1 mx-4 xl:mx-8 site-header-nav">
                    <ul class="flex items-center justify-center text-white text-sm font-semibold tracking-wide">
                        <li><a runat="server" href="~/Default.aspx" class="hover:bg-white/10 hover:text-primary transition-all">Home</a></li>
                        <li><a runat="server" href="~/Shop.aspx" class="hover:bg-white/10 hover:text-primary transition-all">Shop</a></li>
                        <li><a runat="server" href="~/ScreenTime.aspx" class="hover:bg-white/10 hover:text-primary transition-all">Instagram Analyzer</a></li>
                        <li><a runat="server" href="~/ElectricityBill.aspx" class="hover:bg-white/10 hover:text-primary transition-all">Electricity Bill</a></li>
                        <li><a runat="server" href="~/Records.aspx" class="hover:bg-white/10 hover:text-primary transition-all">Records (GridView)</a></li>
                    </ul>
                </nav>

                <!-- Right Section: Auth & Role Info with Clean Separation -->
                <div class="hidden lg:flex items-center shrink-0 text-sm site-header-auth">
                    <% if (Session["Username"] != null) { %>
                        <div class="flex items-center space-x-2.5 bg-gray-900 border border-gray-700 text-white px-3.5 py-1.5 rounded-full shadow-inner">
                            <i class="fa-solid fa-user-circle text-primary text-base"></i>
                            <span class="font-medium"><%= Session["Username"] %></span>
                            <span class="bg-primary text-white text-xs px-2 py-0.5 rounded-full font-bold uppercase"><%= Session["Role"] %></span>
                        </div>
                        <a runat="server" href="~/Logout.aspx" class="bg-red-600 border border-red-600 hover:bg-transparent text-white hover:text-red-400 font-semibold px-5 py-2 rounded-full transition-all shadow">Logout</a>
                    <% } else { %>
                        <a runat="server" href="~/Register.aspx" class="bg-transparent border border-primary text-white hover:bg-primary font-semibold px-5 py-2 rounded-full transition-all">Register</a>
                        <a runat="server" href="~/Login.aspx" class="bg-primary border border-primary hover:bg-transparent text-white hover:text-primary font-semibold px-5 py-2 rounded-full transition-all shadow">Login</a>
                    <% } %>
                </div>
            </div>

            <!-- Mobile Navigation Drawer with Comfortable Tap Spacing -->
            <div id="mobile-menu" class="mobile-menu hidden lg:hidden bg-gray-900 text-white px-6 py-5 border-t border-gray-800">
                <ul class="flex flex-col font-semibold text-sm">
                    <li><a runat="server" href="~/Default.aspx" class="block px-3 py-2 rounded-lg hover:bg-gray-800 hover:text-primary transition">Home</a></li>
                    <li><a runat="server" href="~/Shop.aspx" class="block px-3 py-2 rounded-lg hover:bg-gray-800 hover:text-primary transition">Shop</a></li>
                    <li><a runat="server" href="~/ScreenTime.aspx" class="block px-3 py-2 rounded-lg hover:bg-gray-800 hover:text-primary transition">Instagram Analyzer</a></li>
                    <li><a runat="server" href="~/ElectricityBill.aspx" class="block px-3 py-2 rounded-lg hover:bg-gray-800 hover:text-primary transition">Electricity Bill</a></li>
                    <li><a runat="server" href="~/Records.aspx" class="block px-3 py-2 rounded-lg hover:bg-gray-800 hover:text-primary transition">Database Records (GridView)</a></li>
                    <li class="pt-3 mt-2 border-t border-gray-800 flex flex-col space-y-2.5">
                        <% if (Session["Username"] != null) { %>
                            <div class="text-xs text-gray-300 px-3 py-1">Signed in as <b><%= Session["Username"] %></b> (<%= Session["Role"] %>)</div>
                            <a runat="server" href="~/Logout.aspx" class="bg-red-600 text-center text-white py-2.5 rounded-full font-semibold">Logout</a>
                        <% } else { %>
                            <a runat="server" href="~/Login.aspx" class="bg-primary text-center text-white py-2.5 rounded-full font-semibold shadow">Login</a>
                            <a runat="server" href="~/Register.aspx" class="border border-primary text-center text-white py-2.5 rounded-full font-semibold">Register</a>
                        <% } %>
                    </li>
                </ul>
            </div>
        </header>

        <!-- Main Body Content Placeholder -->
        <main class="flex-grow">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </main>

        <!-- Tailstore Professional Footer -->
        <footer class="site-footer bg-gray-dark text-sm mt-16 border-t border-gray-800">
            <div class="container mx-auto px-4 py-12">
                <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
                    <!-- Column 1: Brand Info -->
                    <div class="space-y-4">
                        <img runat="server" src="~/assets/images/template-white-logo.png" alt="ShopSphere" class="h-6 w-auto site-header-logo" />
                        <p class="text-gray-400 text-sm leading-relaxed">
                            ShopSphere combines a product catalog with practical web tools.
                        </p>
                    </div>

                    <!-- Column 2: Quick Links -->
                    <div>
                        <h4 class="text-white font-bold text-base mb-4 uppercase tracking-wider">Shop</h4>
                        <ul class="space-y-2">
                            <li><a runat="server" href="~/Default.aspx" class="hover:text-primary transition">Home</a></li>
                            <li><a runat="server" href="~/Shop.aspx" class="hover:text-primary transition">Browse products</a></li>
                            <li><a runat="server" href="~/About.aspx" class="hover:text-primary transition">About ShopSphere</a></li>
                            <li><a runat="server" href="~/Contact.aspx" class="hover:text-primary transition">Contact</a></li>
                        </ul>
                    </div>

                    <!-- Account links -->
                    <div>
                        <h4 class="text-white font-bold text-base mb-4 uppercase tracking-wider">Account</h4>
                        <ul class="space-y-2">
                            <li><a runat="server" href="~/Login.aspx" class="hover:text-primary transition">Log in</a></li>
                            <li><a runat="server" href="~/Register.aspx" class="hover:text-primary transition">Create an account</a></li>
                        </ul>
                    </div>

                    <div>
                        <h4 class="text-white font-bold text-base mb-4 uppercase tracking-wider">Project Tools</h4>
                        <ul class="space-y-2">
                            <li><a runat="server" href="~/ScreenTime.aspx" class="hover:text-primary transition">Screen Time Analyzer</a></li>
                            <li><a runat="server" href="~/ElectricityBill.aspx" class="hover:text-primary transition">Electricity Bill Calculator</a></li>
                            <li><a runat="server" href="~/Records.aspx" class="hover:text-primary transition">Database Records</a></li>
                        </ul>
                    </div>
                </div>

                <div class="border-t border-gray-800 mt-10 pt-6 flex flex-col md:flex-row justify-between items-center text-xs text-gray-500">
                    <p>&copy; <%: DateTime.Now.Year %> ShopSphere</p>
                    <p>Designed with Tailstore &bull; Powered by ASP.NET Web Forms</p>
                </div>
            </div>
        </footer>
    </form>

    <!-- Template JavaScript -->
    <script>
        // Responsive mobile menu toggle
        document.addEventListener('DOMContentLoaded', function () {
            var hamburger = document.getElementById('hamburger');
            var mobileMenu = document.getElementById('mobile-menu');
            if (hamburger && mobileMenu) {
                hamburger.addEventListener('click', function () {
                    mobileMenu.classList.toggle('hidden');
                    hamburger.setAttribute('aria-expanded', mobileMenu.classList.contains('hidden') ? 'false' : 'true');
                });
                document.addEventListener('keydown', function (event) {
                    if (event.key === 'Escape' && !mobileMenu.classList.contains('hidden')) {
                        mobileMenu.classList.add('hidden');
                        hamburger.setAttribute('aria-expanded', 'false');
                        hamburger.focus();
                    }
                });
            }

            document.querySelectorAll('.auth-password-toggle').forEach(function (toggle) {
                toggle.addEventListener('click', function () {
                    var input = toggle.previousElementSibling;
                    if (!input) return;

                    var showPassword = input.type === 'password';
                    input.type = showPassword ? 'text' : 'password';
                    toggle.setAttribute('aria-pressed', showPassword ? 'true' : 'false');
                    toggle.setAttribute('aria-label', showPassword ? 'Hide password' : 'Show password');
                    toggle.querySelector('i').className = showPassword ? 'fa-regular fa-eye-slash' : 'fa-regular fa-eye';
                });
            });
        });
    </script>
</body>
</html>
